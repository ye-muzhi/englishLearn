{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "EnglishLearn main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{
        "name": "binaries/englishlearn-server",
        "sidecar": true,
        "args": ["--port", "8501"]
      }]
    }
  ]
}
