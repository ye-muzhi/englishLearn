{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnglishLearn",
  "version": "1.1.0",
  "identifier": "com.englishlearn.desktop",
  "build": { "frontendDist": "../frontend" },
  "app": {
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src http://127.0.0.1:8501 ws://127.0.0.1:8501" },
    "windows": [{
      "label": "main", "title": "EnglishLearn", "url": "index.html",
      "width": 1440, "height": 920, "minWidth": 980, "minHeight": 680,
      "center": true, "resizable": true, "fullscreen": false
    }]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Learn languages with videos and bilingual subtitles",
    "externalBin": ["binaries/englishlearn-server"]
  }
}
